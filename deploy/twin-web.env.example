# /etc/v2x-twin-web.env on path-rfs. NEXT_PUBLIC_* values are inlined at build
# time, so scripts/deploy.sh --web sources this file before building.
PORT=5199
HOSTNAME=127.0.0.1
NODE_ENV=production
NEXT_PUBLIC_TWIN_URL=wss://twin.path2v2x.net
NEXT_PUBLIC_TWIN_HOME_URL=https://path2v2x.net/
NEXT_PUBLIC_TWIN_MAP_MANIFEST_URL=/map-bundles/richmond-field-station/3d/manifest.json
NEXT_PUBLIC_TWIN_MAP_LANES_URL=/map-bundles/richmond-field-station/topology-index.json.gz
NEXT_PUBLIC_TWIN_CAMERA_RIGS_URL=/drive-rigs/richmond.json
