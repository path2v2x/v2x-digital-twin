{
  "name": "@v2x-twin/web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "V2X detection review: the past hour of detections on a timeline, with the annotated camera footage for any instant.",
  "scripts": {
    "dev": "next dev --webpack -p ${PORT:-5199}",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-5199} -H ${HOSTNAME:-127.0.0.1}",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.4.31",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.2",
    "vitest": "^3.0.0"
  }
}
